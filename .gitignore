# Baseline snapshot hygiene for 00_HFT_project.
# Keep source, reports, figures, HLS source, and small CSV provenance files.
# Exclude local runtimes, raw data, generated datasets, and vendor/tool build products.

# Python local environments and caches.
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/

# Local IDE/editor state.
.vscode/
.idea/
~$*

# Raw datasets and generated phase data payloads.
# Reports/scripts/results stay tracked outside data directories.
# data/raw/ is excluded regardless of size for copyright/licensing hygiene.
data/raw/
data/
**/data/

# Temporary or discarded work areas.
trash/
tmp*/
temp/
_backups/

# Binary/model/data artifacts that should be regenerated from scripts.
*.zip
*.7z
*.tar
*.tar.gz
*.npz
*.npy
*.parquet
*.feather
*.pt
*.pth
*.ckpt
*.joblib
*.pkl
*.pickle
*.onnx
*.keras
*.h5

# Native/object/library build products.
*.obj
*.o
*.a
*.lib
*.dll
*.exe
*.exp
*.pdb

# Vitis/Vivado/HLS generated project products.
# HLS source in hls_src/ and text reports outside generated build folders remain trackable.
.Xil/
**/.Xil/
.hls.failed
*.jou
*.wdb
*.vcd
*.vpd
*.str
**/.autopilot/
**/solution*/impl/
**/solution*/sim/
**/solution*/.autopilot/
**/hls4ml_prj/
**/myproject_prj/
**/hls_component/**/hls/sim/
**/hls_component/**/hls/impl/
**/hls_component/**/hls/.autopilot/
**/hls_component/**/hls/syn/verilog/
**/hls_component/**/hls/syn/vhdl/
**/hls_component/**/hls/syn/systemc/

# Large generated logs from FPGA tooling. Markdown reports and .rpt files are not ignored here.
vivado*.log
vitis*.log
xsim*.log
webtalk*.log

# Baseline-generated helper files that should not be staged accidentally.
*.tmp
*.bak

# Specific >50MB files discovered during baseline audit.
# Each path is recorded with SHA256 in EXCLUDED_FILES_MANIFEST.md.
/.venv/Lib/site-packages/clang/native/libclang.dll
/.venv/Lib/site-packages/tensorflow/python/_pywrap_tensorflow_common.dll
/.venv/Lib/site-packages/torch/lib/torch_cpu.dll
